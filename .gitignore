# ============================================================
# .gitignore — portfolio-caraka
# ============================================================

# SQLite databases (tidak dipublikasikan)
*.sqlite
*.db
*.sqlite3

# Data folder (berisi database yang di-generate pipeline)
**/data/*.sqlite
**/data/*.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
env/
.venv/
.env/

# Environment variables & secrets
.env
.env.local
*.env

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
pipeline_*.log

# Jupyter
.ipynb_checkpoints/
*.ipynb

# GitHub Actions cache
.github/workflows/__pycache__/
